{
  "name": "flowdesk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:web && npm run build:api",
    "build:web": "ng build",
    "build:api": "prisma generate --schema apps/api/prisma/schema.prisma && tsc -p apps/api/tsconfig.json",
    "start:api": "node dist/api/apps/api/src/main.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:seed": "tsx apps/api/prisma/seed.ts"
  },
  "dependencies": {
    "@angular/core": "22.2.6",
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/cdk": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.0",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "nodemailer": "^7.0.10",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tslib": "^2.8.1",
    "jspdf": "^3.0.3"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.6",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.57.0",
    "eslint": "^9.39.0",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/nodemailer": "^7.0.3",
    "@types/pdfkit": "^0.17.3",
    "prettier": "^3.6.2",
    "prisma": "6.19.0",
    "tsx": "^4.20.6",
    "vitest": "^4.0.8",
    "@playwright/test": "^1.56.1",
    "lighthouse": "^12.8.2"
  }
}
