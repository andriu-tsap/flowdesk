{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/api",
    "rootDir": "../..",
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "isolatedModules": false,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../../packages/domain/**/*.ts"]
}
